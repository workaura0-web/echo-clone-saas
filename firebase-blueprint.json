{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user account identity",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user authentication identifier"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User public display name"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "System role"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["id", "email"]
    },
    "Profile": {
      "title": "Profile",
      "description": "User subscription package, quotas, expiry, and feature flags",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Matches user authentication ID"
        },
        "email": {
          "type": "string",
          "description": "User email for admin visibility"
        },
        "displayName": {
          "type": "string",
          "description": "Display name"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "starter", "creator", "pro", "business", "enterprise"],
          "description": "Subscription tier"
        },
        "planName": {
          "type": "string",
          "description": "Human readable package name"
        },
        "characterLimit": {
          "type": "number",
          "description": "Total monthly character allotment"
        },
        "usedCharacters": {
          "type": "number",
          "description": "Total characters consumed"
        },
        "maxCharsPerGeneration": {
          "type": "number",
          "description": "Maximum characters allowed in a single script"
        },
        "planStartedAt": {
          "type": "string",
          "description": "ISO timestamp when current package began"
        },
        "planExpiresAt": {
          "type": "string",
          "description": "ISO timestamp when current package expires"
        },
        "isApproved": {
          "type": "boolean",
          "description": "Approval status for studio usage"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "plan", "characterLimit", "usedCharacters", "isApproved"]
    },
    "Generation": {
      "title": "Generation",
      "description": "Log of speech synthesis history with accent, tone, and sentence emotion segments",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique generation record ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "description": "Short script title"
        },
        "text": {
          "type": "string",
          "description": "Text prompt synthesized"
        },
        "voiceId": {
          "type": "string",
          "description": "Selected voice personality ID"
        },
        "voiceName": {
          "type": "string",
          "description": "Name of voice chosen"
        },
        "accentId": {
          "type": "string",
          "description": "Country accent ID"
        },
        "accentLabel": {
          "type": "string",
          "description": "Country accent display label"
        },
        "toneId": {
          "type": "string",
          "description": "Delivery tone ID"
        },
        "toneLabel": {
          "type": "string",
          "description": "Delivery tone display label"
        },
        "engine": {
          "type": "string",
          "description": "Synthesis engine used"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Estimated or actual audio duration in seconds"
        },
        "characterCount": {
          "type": "number",
          "description": "Number of characters in prompt"
        },
        "segmentsJson": {
          "type": "string",
          "description": "Serialized sentence emotion breakdown"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["id", "userId", "text", "voiceId", "characterCount"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment and checkout transaction record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Payment transaction ID"
        },
        "userId": {
          "type": "string",
          "description": "User identifier"
        },
        "userEmail": {
          "type": "string",
          "description": "User email address"
        },
        "planId": {
          "type": "string",
          "enum": ["free", "starter", "creator", "pro", "business", "enterprise"],
          "description": "Requested plan tier ID"
        },
        "planName": {
          "type": "string",
          "description": "Purchased plan name"
        },
        "amount": {
          "type": "number",
          "description": "Amount paid in USD"
        },
        "pricePkr": {
          "type": "string",
          "description": "Amount in PKR"
        },
        "transactionId": {
          "type": "string",
          "description": "Payment reference ID"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "approved", "rejected"],
          "description": "Transaction status"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app user notifications for package expiry, low quota, and plan updates",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Notification document ID"
        },
        "userId": {
          "type": "string",
          "description": "Target user UID"
        },
        "title": {
          "type": "string",
          "description": "Short notification title"
        },
        "message": {
          "type": "string",
          "description": "Notification body text"
        },
        "type": {
          "type": "string",
          "enum": ["info", "warning", "expired", "success"],
          "description": "Severity level"
        },
        "actionHref": {
          "type": "string",
          "description": "Optional navigation route"
        },
        "isRead": {
          "type": "boolean",
          "description": "Whether user has read the alert"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        }
      },
      "required": ["id", "userId", "title", "message", "type", "isRead", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator authorization record",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Admin user UID"
        },
        "email": {
          "type": "string",
          "description": "Admin email"
        },
        "grantedAt": {
          "type": "string",
          "description": "Timestamp when admin privilege was granted"
        }
      },
      "required": ["userId", "email"]
    },
    "PricingPlan": {
      "title": "PricingPlan",
      "description": "Admin-configurable subscription package and credit allocation published to Homepage & Checkout",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["free", "starter", "creator", "pro", "business", "enterprise"],
          "description": "Package identifier"
        },
        "name": {
          "type": "string",
          "description": "Display name of the plan"
        },
        "tagline": {
          "type": "string",
          "description": "Short audience subtitle"
        },
        "priceUsd": {
          "type": "number",
          "description": "Price in USD"
        },
        "priceDisplayUsd": {
          "type": "string",
          "description": "Formatted USD string"
        },
        "pricePkrAmount": {
          "type": "number",
          "description": "Numeric price in PKR"
        },
        "pricePkr": {
          "type": "string",
          "description": "Formatted PKR price string"
        },
        "characterLimit": {
          "type": "number",
          "description": "Monthly credits / character limit"
        },
        "maxCharsPerGeneration": {
          "type": "number",
          "description": "Max characters allowed per generation"
        },
        "validityDays": {
          "type": "number",
          "description": "Subscription duration in days"
        },
        "approxHoursLabel": {
          "type": "string",
          "description": "Approximate monthly audio hours label"
        },
        "libraryLimit": {
          "type": "number",
          "description": "Saved clips limit (-1 for unlimited)"
        },
        "storyEmotionEnabled": {
          "type": "boolean",
          "description": "Whether dynamic multi-emotion narration is included"
        },
        "hdWavExport": {
          "type": "boolean",
          "description": "Whether studio MP3/WAV export is included"
        },
        "commercialRights": {
          "type": "boolean",
          "description": "Whether commercial usage rights are included"
        },
        "isPopular": {
          "type": "boolean",
          "description": "Highlight badge on homepage & checkout"
        },
        "isVisible": {
          "type": "boolean",
          "description": "Whether plan appears on homepage & checkout"
        },
        "sortOrder": {
          "type": "number",
          "description": "Display order"
        },
        "features": {
          "type": "array",
          "description": "List of bullet features (max 12)"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last admin edit"
        }
      },
      "required": ["id", "name", "pricePkrAmount", "characterLimit", "validityDays"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Admin-managed live support contact details including WhatsApp Support number and email",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Configuration document ID"
        },
        "whatsappNumber": {
          "type": "string",
          "description": "WhatsApp Support phone number"
        },
        "supportEmail": {
          "type": "string",
          "description": "Official support email address"
        },
        "companyName": {
          "type": "string",
          "description": "Software house / developer brand name"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last admin update"
        }
      },
      "required": ["id", "whatsappNumber", "supportEmail", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Primary user profile document mapped to auth UID"
    },
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "User subscription package, limits, and expiration profile"
    },
    "/generations/{generationId}": {
      "schema": "Generation",
      "description": "User voice generation history items"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment requests and receipts"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User package expiration and quota alerts"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Collection of verified administrator user IDs"
    },
    "/pricing_plans/{planId}": {
      "schema": "PricingPlan",
      "description": "Admin-managed live subscription packages synced to Home, Checkout, and Studio"
    },
    "/site_settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Admin-managed live support contact settings (WhatsApp number, support email)"
    }
  }
}
