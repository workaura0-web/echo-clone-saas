rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null &&
         request.auth.token.email_verified == true &&
         (request.auth.token.email == "workaura0@gmail.com" || request.auth.token.email == "workaur0@gmail.com"))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
        incoming().keys().hasAll(['id', 'email']) &&
        incoming().id == userId &&
        incoming().email is string && incoming().email.size() <= 200 &&
        (!('photoURL' in incoming()) || (incoming().photoURL is string && incoming().photoURL.size() <= 500)) &&
        (!('acceptedTerms' in incoming()) || incoming().acceptedTerms is bool) &&
        (!('acceptedTermsAt' in incoming()) || (incoming().acceptedTermsAt is string && incoming().acceptedTermsAt.size() <= 64)) &&
        (!('role' in incoming()) || incoming().role == 'user' || isAdmin());
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) &&
        incoming().id == existing().id &&
        (!('photoURL' in incoming()) || (incoming().photoURL is string && incoming().photoURL.size() <= 500)) &&
        (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'username', 'photoURL', 'acceptedTerms', 'acceptedTermsAt']) &&
            (!('username' in existing()) || existing().username == null || existing().username == '' || incoming().username == existing().username)
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Profiles Collection (Packages, Quotas, Expiry, Approvals)
    match /profiles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
        incoming().keys().hasAll(['id', 'plan', 'characterLimit', 'usedCharacters', 'isApproved']) &&
        incoming().id == userId &&
        incoming().usedCharacters is number && incoming().usedCharacters >= 0 &&
        incoming().characterLimit is number && incoming().characterLimit >= 0 &&
        (!('photoURL' in incoming()) || (incoming().photoURL is string && incoming().photoURL.size() <= 500)) &&
        (!('acceptedTerms' in incoming()) || incoming().acceptedTerms is bool) &&
        (!('acceptedTermsAt' in incoming()) || (incoming().acceptedTermsAt is string && incoming().acceptedTermsAt.size() <= 64)) &&
        (isAdmin() || (incoming().plan == 'free' && incoming().characterLimit <= 10000));
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().id == existing().id &&
          incoming().usedCharacters is number &&
          incoming().usedCharacters >= 0 &&
          (!('photoURL' in incoming()) || (incoming().photoURL is string && incoming().photoURL.size() <= 500)) &&
          (
            // Owner incrementing character usage
            incoming().diff(existing()).affectedKeys().hasOnly(['usedCharacters', 'updatedAt']) ||
            // Owner claiming username once or updating displayName, photoURL, or Terms acceptance
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'photoURL', 'acceptedTerms', 'acceptedTermsAt', 'updatedAt']) &&
              (!('username' in existing()) || existing().username == null || existing().username == '' || incoming().username == existing().username)
            ) ||
            // Owner activating/renewing free starter plan
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['plan', 'planName', 'characterLimit', 'usedCharacters', 'maxCharsPerGeneration', 'planStartedAt', 'planExpiresAt', 'updatedAt']) &&
              incoming().plan == 'free' &&
              incoming().characterLimit <= 10000
            )
          )
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Username Lookup Index (Exact single-doc lookup for sign-in & availability; NO public list to prevent scraping)
    match /usernames/{usernameId} {
      allow get: if isValidId(usernameId) && usernameId.size() >= 3 && usernameId.size() <= 24;
      allow list: if isAdmin();
      allow create: if isValidId(usernameId) &&
        usernameId.size() >= 3 && usernameId.size() <= 24 &&
        isSignedIn() &&
        incoming().uid == request.auth.uid &&
        incoming().keys().hasAll(['uid', 'email', 'username']) &&
        incoming().keys().hasOnly(['uid', 'email', 'username', 'createdAt']) &&
        incoming().uid is string &&
        incoming().email is string && incoming().email.size() <= 200 &&
        incoming().username is string && incoming().username.size() >= 3 && incoming().username.size() <= 24;
      allow update: if isValidId(usernameId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          existing().uid == request.auth.uid &&
          incoming().uid == existing().uid &&
          incoming().keys().hasOnly(['uid', 'email', 'username', 'createdAt'])
        )
      );
      allow delete: if isValidId(usernameId) && isAdmin();
    }

    function isValidPricingPlan(data) {
      return data.keys().hasAll(['id', 'name', 'pricePkrAmount', 'characterLimit', 'validityDays']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 32 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
        data.pricePkrAmount is number && data.pricePkrAmount >= 0 && data.pricePkrAmount <= 10000000 &&
        data.characterLimit is number && data.characterLimit >= 0 && data.characterLimit <= 100000000 &&
        data.validityDays is number && data.validityDays >= 1 && data.validityDays <= 3650 &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 240)) &&
        (!('pricePkr' in data) || (data.pricePkr is string && data.pricePkr.size() <= 60)) &&
        (!('priceDisplayUsd' in data) || (data.priceDisplayUsd is string && data.priceDisplayUsd.size() <= 32)) &&
        (!('approxHoursLabel' in data) || (data.approxHoursLabel is string && data.approxHoursLabel.size() <= 60)) &&
        (!('features' in data) || (data.features is list && data.features.size() <= 15));
    }

    // Generations Collection (TTS History)
    match /generations/{generationId} {
      allow get: if isValidId(generationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(generationId) && isSignedIn() &&
        incoming().keys().hasAll(['userId', 'text', 'voiceId', 'characterCount']) &&
        incoming().userId == request.auth.uid &&
        incoming().text is string && incoming().text.size() <= 50000 &&
        incoming().voiceId is string && incoming().voiceId.size() <= 128 &&
        incoming().characterCount is number && incoming().characterCount >= 0;
      allow update: if isValidId(generationId) && isSignedIn() &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().userId == existing().userId;
      allow delete: if isValidId(generationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(paymentId) && isSignedIn() &&
        incoming().keys().hasAll(['userId', 'planName', 'status']) &&
        incoming().userId == request.auth.uid &&
        incoming().planName is string && incoming().planName.size() <= 100 &&
        incoming().status == 'pending';
      allow update: if isValidId(paymentId) && isAdmin();
      allow delete: if isValidId(paymentId) && isAdmin();
    }

    // Notifications Collection (Expiry, Quota, Payment Updates)
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(notificationId) && isSignedIn() && (
        isAdmin() ||
        (
          incoming().userId == request.auth.uid &&
          incoming().keys().hasAll(['userId', 'title', 'message', 'type', 'isRead', 'createdAt']) &&
          incoming().title is string && incoming().title.size() <= 160 &&
          incoming().message is string && incoming().message.size() <= 600
        )
      );
      allow update: if isValidId(notificationId) && isSignedIn() && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']))
      );
      allow delete: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Admins Collection
    match /admins/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow write: if isValidId(userId) && isAdmin();
    }

    // Dynamic Pricing Plans (Public Read for Homepage & Checkout, Admin-Only Write)
    match /pricing_plans/{planId} {
      allow get: if isValidId(planId);
      allow list: if true;
      allow create, update: if isValidId(planId) && isAdmin() && isValidPricingPlan(incoming());
      allow delete: if isValidId(planId) && isAdmin();
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['id', 'whatsappNumber', 'supportEmail', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'whatsappNumber', 'supportEmail', 'facebookUrl', 'companyName', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 7 && data.whatsappNumber.size() <= 40 &&
        data.supportEmail is string && data.supportEmail.size() >= 3 && data.supportEmail.size() <= 120 &&
        (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 300)) &&
        (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 80)) &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Live Site Support Settings (Public Get for Floating WhatsApp / Footer / Contact, Admin-Only Write)
    match /site_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow create, update: if isValidId(settingId) && isAdmin() && isValidSiteSettings(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }
  }
}
